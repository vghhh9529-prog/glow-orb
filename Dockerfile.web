FROM node:22-slim

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ENV NODE_ENV=production
ENV NITRO_PRESET=node-server
RUN pnpm build

EXPOSE 3000
CMD ["pnpm", "start"]

# هذا المسار مخصص لخدمة Dashboard فقط؛ خدمة Discord Gateway تستمر باستخدام Dockerfile.bot.
